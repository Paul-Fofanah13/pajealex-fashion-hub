# Copy this file to ".env" and fill in your own values.
# NEVER upload the real ".env" file to GitHub.

# Long random text used to sign login/cart cookies. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace-with-a-long-random-string

# Your WhatsApp business number: country code + number, digits only.
# Example format: 234XXXXXXXXXX (no + sign, no spaces, no leading 0)
WHATSAPP_NUMBER=

# Shown in the footer and contact page. Leave blank to hide.
STORE_EMAIL=
STORE_PHONE=
STORE_ADDRESS=
INSTAGRAM_URL=
FACEBOOK_URL=
TIKTOK_URL=

# Set to 1 only when the site runs on https (for example on Render).
COOKIE_SECURE=0

# Optional: change where the database and uploaded photos are stored.
# On Render these should point to a persistent disk (see README, Stage 2).
# DATABASE_PATH=
# UPLOAD_DIR=

# ---- Admin login (run: python make_admin_hash.py and paste its output here) ----
ADMIN_USERNAME=
ADMIN_PASSWORD_HASH=

# ---- Online payments (optional). Leave blank to use WhatsApp / cash on delivery only ----
# Use a TEST key (starts with sk_test_) until you have tested everything.
PAYSTACK_SECRET_KEY=

# Set to 1 on Render so the site sees real visitor addresses behind its proxy.
BEHIND_PROXY=0

# Set to 1 on your own computer only if you want detailed error pages.
FLASK_DEBUG=0
